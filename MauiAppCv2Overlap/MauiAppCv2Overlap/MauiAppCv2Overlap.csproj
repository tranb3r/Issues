<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>MauiAppCv2Overlap</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Display name -->
		<ApplicationTitle>MauiAppCv2Overlap</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.mauiappcv2overlap</ApplicationId>
		<ApplicationIdGuid>b4e2c9a0-6d5b-4e9c-9f2a-7c8d1e0f3a6b</ApplicationIdGuid>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios'">
	  <CodesignKey>Apple Development: Created via API (8LC8UPC95H)</CodesignKey>
	  <CodesignProvision>VS: WildCard Development</CodesignProvision>
	</PropertyGroup>

	<ItemGroup>
		<!-- Pinned to match OuiBank (10.0.101): CollectionViewHandler2 (CV2) is the default iOS handler
		     there and reproduces the bug. Bump this line to re-test on newer MAUI versions. -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.101" />
	</ItemGroup>

</Project>
